# Copy to .env and replace both placeholder secrets before starting the stack.
FLOWABLE_DB_PASSWORD=replace-with-a-long-random-password
FLOWABLE_REST_USER=rest-admin
FLOWABLE_REST_PASSWORD=replace-with-a-different-long-random-password
FLOWABLE_BIND_ADDRESS=127.0.0.1
FLOWABLE_PORT=18091
FLOWABLE_JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m -XX:+UseG1GC
